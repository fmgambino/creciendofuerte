DirectoryIndex login.php index.php
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Forzar HTTPS solo en producción, nunca en XAMPP/localhost.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Archivos/carpetas reales.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# URLs limpias. Funciona en raíz de Hostinger y en subcarpetas de XAMPP.
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^(dashboard|perfil|users|usuarios|roles|socios|referidos|profits|ganancias-broker|distribuciones|capitales|retiros|whatsapp|notificaciones|auditoria)/?$ index.php?view=$1 [L,QSA]
RewriteRule ^$ login.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options nosniff
Header set X-Frame-Options SAMEORIGIN
</IfModule>
